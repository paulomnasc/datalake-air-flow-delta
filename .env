#--------------------------------------------------------------------
# ARQUIVO .ENV PARA DOCKER-COMPOSE - PRODUÇÃO
# Este arquivo é lido pelo docker-compose.yml
# INSTRUÇÕES: Renomeie para .env antes de fazer deploy em produção
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# VARIÁVEIS DO DOCKER (MySQL)
#--------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=YM11rMrT32xH0E6N
MYSQL_DATABASE=lista_revisao2
UID=1000
GID=1000

#--------------------------------------------------------------------
# PORTAS DOS SERVIÇOS (Docker Compose) - PRODUÇÃO
# Portas altas para evitar conflitos com serviços do sistema
#--------------------------------------------------------------------
# NGINX (Reverse Proxy Gateway)
NGINX_PORT_HTTP=28080
NGINX_PORT_HTTPS=28443

# SPARK
SPARK_PORT_RPC=27077
SPARK_PORT_WEB=28081
SPARK_WORKER_PORT=28082

# PostgreSQL (Airflow)
POSTGRES_PORT=25432

# PostgreSQL (Business Intelligence)
POSTGRES_BI_PORT=25433

# Redis
REDIS_PORT=26379

# MySQL
MYSQL_PORT=23306

# Airflow Webserver
AIRFLOW_WEBSERVER_PORT=28083

# Airflow Scheduler (Debugger)
AIRFLOW_SCHEDULER_DEBUG_PORT=25678

# MinIO (S3-compatible)
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001

# DuckDB API
DUCKDB_API_PORT=25000

# CodeIgniter (Web App)
CODEIGNITER_PORT=28088
CODEIGNITER_XDEBUG_PORT=29003

# Apache Atlas
ATLAS_PORT=31000

# PySpark Aula (Jupyter + Spark)
JUPYTER_PORT=28888
SPARK_UI_PORT=24040

#--------------------------------------------------------------------
# NGINX CONFIGURATION
#--------------------------------------------------------------------
# SSL habilitado? (true/false)
NGINX_SSL_ENABLED=false

# Domínio/servidor
NGINX_SERVER_NAME=localhost

# Caminhos dos certificados SSL (apenas para produção)
NGINX_SSL_CERT=/etc/letsencrypt/live/myflow.estudotabela.com.br/fullchain.pem
NGINX_SSL_KEY=/etc/letsencrypt/live/myflow.estudotabela.com.br/privkey.pem

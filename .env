#--------------------------------------------------------------------
# ARQUIVO .ENV PARA DOCKER-COMPOSE - AMBIENTE DE TESTE
# Este arquivo é lido pelo docker-compose.yml
# INSTRUÇÕES: cp .env-test .env (antes de rodar em teste)
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# AMBIENTE (Sufixo para nomes de containers)
#--------------------------------------------------------------------
ENV_SUFFIX=test

#--------------------------------------------------------------------
# VARIÁVEIS DO DOCKER (MySQL)
#--------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=YM11rMrT32xH0E6N
MYSQL_DATABASE=lista_revisao2_test
UID=1000
GID=1000

#--------------------------------------------------------------------
# PORTAS DOS SERVIÇOS (Docker Compose) - TESTE
# Portas 29xxx para evitar conflitos com produção (28xxx)
#--------------------------------------------------------------------
# NGINX (Reverse Proxy Gateway)
NGINX_PORT_HTTP=29080
NGINX_PORT_HTTPS=29443

# SPARK
SPARK_PORT_RPC=27078
SPARK_PORT_WEB=29081
SPARK_WORKER_PORT=29082

# PostgreSQL (Airflow)
POSTGRES_PORT=26432

# PostgreSQL (Business Intelligence)
POSTGRES_BI_PORT=26433

# Redis
REDIS_PORT=26380

# MySQL
MYSQL_PORT=24306

# Airflow Webserver
AIRFLOW_WEBSERVER_PORT=29083

# Airflow Scheduler (Debugger)
AIRFLOW_SCHEDULER_DEBUG_PORT=26678

# MinIO (S3-compatible)
MINIO_API_PORT=30000
MINIO_CONSOLE_PORT=30001

# DuckDB API
DUCKDB_API_PORT=26000

# CodeIgniter (Web App)
CODEIGNITER_PORT=29088
CODEIGNITER_XDEBUG_PORT=30003

# Apache Atlas
ATLAS_PORT=32000

# PySpark Aula (Jupyter + Spark)
JUPYTER_PORT=29888
SPARK_UI_PORT=25040

#--------------------------------------------------------------------
# NGINX CONFIGURATION
#--------------------------------------------------------------------
# SSL habilitado? (true/false)
NGINX_SSL_ENABLED=false

# Domínio/servidor
NGINX_SERVER_NAME=46.224.156.251

# Caminhos dos certificados SSL (apenas para produção)
NGINX_SSL_CERT=/etc/letsencrypt/live/test.myflow.estudotabela.com.br/fullchain.pem
NGINX_SSL_KEY=/etc/letsencrypt/live/test.myflow.estudotabela.com.br/privkey.pem

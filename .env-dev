#--------------------------------------------------------------------
# ARQUIVO .ENV PARA DOCKER-COMPOSE
# Este arquivo é lido pelo docker-compose.yml
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# VARIÁVEIS DO DOCKER (MySQL)
#--------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lista_revisao2
UID=1000
GID=1000
DOCKER_GID=988

#--------------------------------------------------------------------
# PORTAS DOS SERVIÇOS (Docker Compose)
#--------------------------------------------------------------------
# NGINX (Reverse Proxy Gateway)
NGINX_PORT_HTTP=8090
NGINX_PORT_HTTPS=8443
NGINX_SERVER_NAME=localhost

# SPARK
SPARK_PORT_RPC=7077
SPARK_PORT_WEB=8080
SPARK_WORKER_PORT=8081

# PostgreSQL (Airflow)
POSTGRES_PORT=5432

# PostgreSQL (Business Intelligence)
POSTGRES_BI_PORT=5433

# Redis
REDIS_PORT=6379

# MySQL
MYSQL_PORT=3306

# Airflow Webserver
AIRFLOW_WEBSERVER_PORT=8082

# Airflow Scheduler (Debugger)
AIRFLOW_SCHEDULER_DEBUG_PORT=5678

# MinIO (S3-compatible)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_EXTERNAL_URL=http://localhost:9000
MINIO_API_PORT_HTTP=9002

# DuckDB API
DUCKDB_API_PORT=5000

# CodeIgniter (Web App)
CODEIGNITER_PORT=8088
CODEIGNITER_XDEBUG_PORT=9003

# Apache Atlas
ATLAS_PORT=21000

# PySpark Aula (Jupyter + Spark)
JUPYTER_PORT=8888
SPARK_UI_PORT=4040

# Metabase (Visualização)
METABASE_PORT=3000


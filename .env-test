#--------------------------------------------------------------------
# ARQUIVO .ENV PARA DOCKER-COMPOSE - TESTE/HOMOLOGAÇÃO
# Este arquivo é lido pelo docker-compose.yml
# INSTRUÇÕES: Copie para .env antes de fazer `docker-compose up -d`
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# VARIÁVEIS DO DOCKER (MySQL)
#--------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=YM11rMrT32xH0E6N
MYSQL_DATABASE=lista_revisao2_test
UID=1000
GID=1000

#--------------------------------------------------------------------
# PORTAS DOS SERVIÇOS (Docker Compose) - TESTE
# Portas altas para evitar conflitos com serviços do sistema
#--------------------------------------------------------------------
# NGINX (Reverse Proxy Gateway)
NGINX_PORT_HTTP=29080
NGINX_PORT_HTTPS=29443

# SPARK
SPARK_PORT_RPC=27077
SPARK_PORT_WEB=29081
SPARK_WORKER_PORT=29082

# PostgreSQL (Airflow)
POSTGRES_PORT=25432

# PostgreSQL (Business Intelligence)
POSTGRES_BI_PORT=25433

# Redis
REDIS_PORT=26379

# MySQL
MYSQL_PORT=23306

# Airflow Webserver
AIRFLOW_WEBSERVER_PORT=29083

# Airflow Scheduler (Debugger)
AIRFLOW_SCHEDULER_DEBUG_PORT=25678

# MinIO (S3-compatible)
MINIO_API_PORT=30000
MINIO_CONSOLE_PORT=30001
MINIO_EXTERNAL_URL=http://localhost:30000
MINIO_API_PORT_HTTP=30002

# DuckDB API
DUCKDB_API_PORT=25000

# CodeIgniter (Web App) - Porta interna, não exposta diretamente
CODEIGNITER_PORT=29088
CODEIGNITER_XDEBUG_PORT=29003

# Apache Atlas
ATLAS_PORT=31000

# PySpark Aula (Jupyter + Spark)
JUPYTER_PORT=29888
SPARK_UI_PORT=24040

#--------------------------------------------------------------------
# NGINX CONFIGURATION
#--------------------------------------------------------------------
# SSL habilitado? (true/false)
NGINX_SSL_ENABLED=false

# Domínio/servidor (IP para teste local)
NGINX_SERVER_NAME=46.224.156.251

# Caminhos dos certificados SSL (não usado em teste)
NGINX_SSL_CERT=/etc/letsencrypt/live/myflow.estudotabela.com.br/fullchain.pem
NGINX_SSL_KEY=/etc/letsencrypt/live/myflow.estudotabela.com.br/privkey.pem

#--------------------------------------------------------------------
# ENVIRONMENT SUFFIX (sufixo para teste)
#--------------------------------------------------------------------
ENV_SUFFIX=test

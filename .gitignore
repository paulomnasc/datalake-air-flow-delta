# Ignorar arquivos e pastas específicas
*.log
*.tmp
*.bkp
*.meta
*.pyc
temp/
build/
writable/
uploads/
uploads/backup/
lixo/
tests/
copia/
data/.minio.sys/
__pycache__/

# Ignorar arquivos de configuração de batch gerados automaticamente
src/dags/configs/*.yml
writable/configs/*.yml

# Ignorar dependências de projetos Node.js
node_modules/

# Ignorar dependências PHP Composer
vendor/
src/codeigniter-app/vendor/

# Ignorar configurações específicas do sistema operacional
.DS_Store
Thumbs.db

# Ignorar arquivos pessoais de configuração do VSCode
#.vscode/
.env
# Ignorar variáveis de ambiente (não versionar segredos)
.env
.env.*
src/codeigniter-app/.env
src/codeigniter-app/.env.local
src/codeigniter-app/.env.production

# Ignorar certificados locais
certs/

# Ignorar arquivos de configuração do JetBrains IDEs
data/.minio.sys/

{
    // Configurações do Python
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none",
        "reportMissingModuleSource": "none"
    },
    "python.defaultInterpreterPath": "python3",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src/dags",
        "${workspaceFolder}/scripts"
    ],

    // =========================================================================
    // CONFIGURAÇÃO CORRETA DO DEPLOY RELOADED
    // A chave principal deve ser 'deploy.reloaded'
    // =========================================================================
    "deploy.reloaded": {
        
        // Seus targets de deploy vão aqui, sob a chave 'targets'
        "targets": [
            {
                "name": "OracleLinux-Airflow-Sync",
                "type": "sftp",
                
                // Configurações de Conexão
                "host": "137.131.212.68",
                "port": 22,
                "user": "opc",
                "privateKey": "C:/ssh-keys/id_rsa_pem.key",
                "remoteRoot": "/datalake-air-flow/",

                // Arquivos e Pastas a serem Sincronizados
                // Usando a sintaxe simplificada do seu exemplo de projeto
                "include": [
                    "dags", 
                    "src",
                    "spark-conf",
                    "docker-compose.yml",
                    "Dockerfile",
                    "requirements.txt",
                    "entrypoint.sh",
                    "airflow.cfg"
                ],
                
                // Exceções
                "exclude": [
                    ".git/**",
                    ".vscode/**",
                    "**/__pycache__/**",
                    "**/data/**", 
                    "node_modules/**"
                ],
                
                "uploadOnSave": true
            }
        ]
        // Se você não usa "packages", pode omitir a chave.
    },

    // Configuração de Log (opcional, no nível raiz)
    "deploy.logLevel": "info",

    "php.debug.debugServerPort": 9004,
    "php.debug.ideKey": "vscode",
    "chat.tools.terminal.autoApprove": {
        "docker-compose": true
    },

    
    // Configuração do Cline para usar Ollama + DeepSeek
    "cline.provider": "ollama",
    "cline.model": "deepseek-r1",
    "cline.ollamaBaseUrl": "http://127.0.0.1:11434"

}
## Bloco removido: estudotabela.com.br não é servido neste ambiente



# Bloco para airflow na porta airflow (variável da porta)
server {
    listen ${AIRFLOW_WEBSERVER_PORT};
    server_name ${NGINX_SERVER_NAME};

    location / {
        proxy_pass http://airflow-webserver:${AIRFLOW_WEBSERVER_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Servidor padrão - rejeita requisições sem Host correto
server {
    listen ${NGINX_PORT_HTTP} default_server;
    server_name _;
    return 444; # Fecha conexão sem resposta
}

# VirtualHost HTTP (sempre presente)
server {
    listen ${NGINX_PORT_HTTP};
    server_name ${NGINX_SERVER_NAME};
    
    # Se SSL habilitado, redireciona para HTTPS; se não, processa direto
    location / {
        proxy_pass http://codeigniter-app:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# VirtualHost HTTPS (apenas se SSL habilitado)
## Bloco HTTPS removido em ambientes sem SSL
# Para habilitar HTTPS, use o template myflow-ssl.conf.template e ajuste o docker-compose.yml conforme documentação.

# Bloco para responder ao desafio da Let's Encrypt (Renovar certificado SSL)
server {
    listen 80;
    server_name myflow.estudotabela.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
# Bloco para airflow na porta 28083
server {
    listen 28083;
    server_name ${NGINX_SERVER_NAME};

    location / {
        proxy_pass http://airflow-webserver:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Servidor padrão - rejeita requisições sem Host correto
server {
    listen 80 default_server;
    server_name _;
    return 444; # Fecha conexão sem resposta
}

# HTTP - CodeIgniter (sempre ativo)
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    
    # Limite de tamanho para uploads
    client_max_body_size 200M;
    
    location / {
        proxy_pass http://codeigniter-app:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

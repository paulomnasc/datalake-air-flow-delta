# Bloco para airflow na porta airflow (variável da porta)
server {
    listen ${AIRFLOW_WEBSERVER_PORT};
    server_name ${NGINX_SERVER_NAME};

    location / {
        proxy_pass http://airflow-webserver:${AIRFLOW_WEBSERVER_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Servidor padrão - rejeita requisições sem Host correto
server {
    listen ${NGINX_PORT_HTTP} default_server;
    server_name _;
    return 444; # Fecha conexão sem resposta
}

# VirtualHost HTTP (sempre presente)
server {
    listen ${NGINX_PORT_HTTP};
    server_name ${NGINX_SERVER_NAME};
    
    # Se SSL habilitado, redireciona para HTTPS; se não, processa direto
    location / {
        proxy_pass http://codeigniter-app:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse proxy para Delta Sharing Server
    location /delta-sharing {
        proxy_pass http://delta-sharing-server:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Redirect /n8n to /n8n/
    rewrite ^/n8n$ /n8n/ permanent;

    # Reverse proxy para n8n
    location /n8n/ {
        proxy_pass http://n8n:5678/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSockets support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# Proxy reverso para MinIO (S3 API)
server {
    listen ${MINIO_API_PORT_HTTP};
    server_name ${NGINX_SERVER_NAME};

    client_max_body_size 1000M;

    location / {
        proxy_pass http://minio:9000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

# VirtualHost HTTPS (apenas se SSL habilitado)
## Bloco HTTPS removido em ambientes sem SSL
# Para habilitar HTTPS, use o template myflow-ssl.conf.template e ajuste o docker-compose.yml conforme documentação.

# Bloco para responder ao desafio da Let's Encrypt (Renovar certificado SSL)
server {
    listen 80;
    server_name myflow.estudotabela.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
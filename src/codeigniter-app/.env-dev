#--------------------------------------------------------------------
# Example Environment Configuration file - DEV
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = DEVELOPMENT

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
#SE COLOCAR NO .ENV NÃO PRECISA COLOCAR NO CONFIG\APP.PHP

# LEMBRE-SE: Na rede interna o IP MUDA !!!
#app.baseURL = 'http://192.168.0.75:8080/'

# URL PRA DESENVOLVIMENTO NO VSCODE (DEV)
# app_baseURL é construída automaticamente a partir do .env raiz
# Para override manual, descomente e defina:
# app_baseURL = 'http://localhost:8088/'

#URL DE PRODUÇÃO
# app_baseURL = 'https://myflow.estudotabela.com.br:28443/'

#MEU DOMÍNIO = resumomaster.com
 
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = mysql
database.default.username = root
database.default.password = root
database.default.database = lista_revisao2
database.default.DBDriver = MySQLi

# database.default.DBPrefix =
# database.default.port = 3306

#--------------------------------------------------------------------
# SMTP PRODUCTION Credentials
#--------------------------------------------------------------------
smtp_host = mail.estudotabela.com.br 
pop_imap_host = mail.estudotabela.com.br
smtp_port  = 587
smtp_username = admin@estudotabela.com.br
smtp_password = kJ#212394
smtp_nome_remetente = Smart_Tables_TEST
smtp_secure = tls

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = hex2bin:3682f0d41371c328b887285ed623b8c65d49d1f9174d6d6a512cc9f2c4afd05b

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# MINIO CONFIGS
#--------------------------------------------------------------------
MINIO_ENDPOINT = http://minio:9000
MINIO_REGION = us-east-1
MINIO_VERSION = latest
MINIO_USE_PATH_STYLE_ENDPOINT = true
MINIO_ACCESS_KEY_ID = admin 
MINIO_SECRET_ACCESS_KEY = admin123

# Nome do bucket de destino (para ser usado no Controller)
MINIO_BUCKET_RAW = data-lake-raw-dev

# Configuração do Airflow para integração na webapp
AIRFLOW_HOST=airflow-webserver
AIRFLOW_PORT=8080

# Limite de armazenamento por usuário no MinIO (em bytes)
# Padrão: 1073741824 = 1GB
# Exemplos: 
#   - 104857600 = 100MB
#   - 524288000 = 500MB
#   - 1073741824 = 1GB
#   - 5368709120 = 5GB
#   - 10737418240 = 10GB
MINIO_USER_STORAGE_LIMIT = 10485760

#--------------------------------------------------------------------
# PORTAS DOS SERVIÇOS (Docker Compose) - DEV
#--------------------------------------------------------------------
# NGINX (Reverse Proxy Gateway)
NGINX_PORT_HTTP=8090
NGINX_PORT_HTTPS=8443

# SPARK
SPARK_PORT_RPC=7077
SPARK_PORT_WEB=8080
SPARK_WORKER_PORT=8081

# PostgreSQL (Airflow)
POSTGRES_PORT=5432

# PostgreSQL (Business Intelligence)
POSTGRES_BI_PORT=5433

# Redis
REDIS_PORT=6379

# MySQL
MYSQL_PORT=3306

# Airflow Webserver
AIRFLOW_WEBSERVER_PORT=8082

# Airflow Scheduler (Debugger)
AIRFLOW_SCHEDULER_DEBUG_PORT=5678

# MinIO (S3-compatible)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# DuckDB API
DUCKDB_API_PORT=5000

# CodeIgniter (Web App)
CODEIGNITER_PORT=8088
CODEIGNITER_XDEBUG_PORT=9003

# Apache Atlas
ATLAS_PORT=21000

# PySpark Aula (Jupyter + Spark)
JUPYTER_PORT=8888
SPARK_UI_PORT=4040

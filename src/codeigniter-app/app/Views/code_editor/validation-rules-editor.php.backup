    }
    
    .template-section {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 16px;
        margin-top: 16px;
    }
    
    .template-section h3 {
        margin: 0 0 12px 0;
        font-size: 14px;
        color: #10b981;
    }
    
    .template-item {
        background: #1e293b;
        padding: 12px;
        border-radius: 4px;
        margin-bottom: 8px;
        cursor: pointer;
        border: 1px solid transparent;
    }
    
    .template-item:hover {
        border-color: #10b981;
    }
    
    .template-item h4 {
        margin: 0 0 4px 0;
        font-size: 13px;
